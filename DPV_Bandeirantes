<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>DPV — Bandeirantes Diagnósticos</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        :root {
            --bg:          #F5F8F7;
            --surface:     #FFFFFF;
            --teal-dark:   #154F4A;
            --teal:        #00B5AD;
            --teal-mid:    #4ECDC4;
            --teal-light:  #E6F7F6;
            --teal-xlight: #F0FAFA;
            --text:        #1A2A2A;
            --text-sec:    #4A5A58;
            --text-muted:  #8A9A98;
            --border:      #D6E8E7;
            --border-light:#EBF4F3;
            --success:     #10B981;
            --danger:      #D32F2F;
            --warn:        #D97706;
            --info:        #0EA5E9;
            --font-sans:   "DM Sans", sans-serif;
            --font-serif:  "DM Serif Display", serif;
            --sidebar-w:   288px;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; overflow-wrap: break-word; }
        html, body { overflow-x: hidden; max-width: 100vw; }
        body { font-family: var(--font-sans); background: var(--bg); color: var(--text); line-height: 1.7; display: flex; height: 100vh; overflow: hidden; -webkit-font-smoothing: antialiased; }

        /* ── SIDEBAR ── */
        .sidebar { width: var(--sidebar-w); background: var(--teal-dark); display: flex; flex-direction: column; flex-shrink: 0; border-right: 1px solid rgba(255,255,255,0.06); }
        .sidebar-logo { padding: 28px 24px 20px; border-bottom: 1px solid rgba(255,255,255,0.1); }
        .sidebar-logo img { width: 100%; max-width: 200px; display: block; }
        .sidebar-meta { padding: 16px 24px; border-bottom: 1px solid rgba(255,255,255,0.08); font-size: 12px; color: rgba(255,255,255,0.5); line-height: 1.7; }
        .sidebar-meta strong { color: var(--teal-mid); display: block; margin-bottom: 4px; font-size: 10px; text-transform: uppercase; letter-spacing: 1.5px; }
        .sidebar-nav { padding: 20px 14px; display: flex; flex-direction: column; gap: 6px; flex: 1; overflow-y: auto; }
        .nav-item { display: flex; align-items: center; gap: 12px; padding: 13px 16px; color: rgba(255,255,255,0.65); text-decoration: none; font-size: 14px; font-weight: 500; border-radius: 10px; transition: all 0.25s; }
        .nav-item i { font-size: 15px; width: 18px; text-align: center; color: rgba(255,255,255,0.4); transition: color 0.25s; }
        .nav-item:hover { background: rgba(255,255,255,0.07); color: #fff; }
        .nav-item:hover i { color: var(--teal-mid); }
        .nav-item.active { background: var(--teal); color: #fff; box-shadow: 0 4px 14px rgba(0,181,173,0.35); }
        .nav-item.active i { color: #fff; }
        .sidebar-footer { padding: 16px 24px; border-top: 1px solid rgba(255,255,255,0.08); font-size: 11px; color: rgba(255,255,255,0.3); line-height: 1.5; }

        /* ── MAIN ── */
        .main-content { flex: 1; overflow-y: auto; overflow-x: hidden; background: var(--bg); }
        .tab-content { display: none; animation: fadeIn 0.35s ease; }
        .tab-content.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

        /* ── TAB HEADER ── */
        .tab-header { background: var(--teal-dark); padding: 40px 48px; position: relative; overflow: hidden; }
        .tab-header::before { content: ""; position: absolute; top: -60px; right: -60px; width: 300px; height: 300px; border-radius: 50%; background: rgba(0,181,173,0.12); pointer-events: none; }
        .tab-header::after { content: ""; position: absolute; bottom: -80px; right: 80px; width: 200px; height: 200px; border-radius: 50%; background: rgba(0,181,173,0.07); pointer-events: none; }
        .tab-header .eyebrow { font-size: 11px; text-transform: uppercase; letter-spacing: 2.5px; color: var(--teal-mid); font-weight: 700; margin-bottom: 10px; }
        .tab-header h1 { font-family: var(--font-serif); font-size: 34px; color: #fff; margin-bottom: 10px; word-wrap: break-word; position: relative; z-index: 1; }
        .tab-header p { color: rgba(255,255,255,0.65); font-size: 15px; max-width: 720px; position: relative; z-index: 1; }

        /* ── CONTAINER ── */
        .container { max-width: 920px; margin: 0 auto; padding: 40px 48px 80px; }

        /* ── SECTION TITLE ── */
        h2.section-title { font-family: var(--font-serif); color: var(--teal-dark); font-size: 24px; background: var(--teal-xlight); border-left: 5px solid var(--teal); padding: 15px 22px; border-radius: 0 8px 8px 0; margin-top: 52px; margin-bottom: 28px; font-weight: 600; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; box-shadow: 0 2px 10px rgba(0,181,173,0.07); }
        .badge-num { background: var(--teal-dark); color: var(--teal-mid); font-family: var(--font-sans); font-size: 10px; font-weight: 700; padding: 5px 10px; border-radius: 4px; letter-spacing: 1px; }
        h3.subsection-title { font-family: var(--font-serif); font-size: 20px; margin: 36px 0 14px; color: var(--teal-dark); }

        /* ── CARDS ── */
        .profile-card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 30px; margin-bottom: 28px; box-shadow: 0 2px 12px rgba(0,0,0,0.04); border-left: 4px solid var(--teal); }
        .profile-card.gold-tier { border-left: 5px solid var(--teal); background: linear-gradient(150deg,#fff,var(--teal-xlight)); }
        .profile-tag { display: inline-block; background: var(--teal-dark); color: var(--teal-mid); font-size: 10px; font-weight: 700; padding: 4px 10px; border-radius: 4px; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 12px; }
        .profile-card h3 { font-family: var(--font-serif); font-size: 22px; font-weight: 400; color: var(--text); margin-bottom: 2px; }
        .profile-card .subtitle { font-size: 13px; color: var(--text-muted); font-style: italic; margin-bottom: 20px; display: block; }
        .profile-block { background: var(--bg); padding: 16px 20px; border-radius: 6px; margin: 14px 0; border-left: 3px solid var(--border); }
        .profile-block h5 { font-size: 10px; text-transform: uppercase; letter-spacing: 1.2px; color: var(--text-muted); margin-bottom: 6px; }
        .profile-block p { font-size: 14px; color: var(--text-sec); line-height: 1.6; margin: 0; }

        /* ── LISTS ── */
        .feature-list { list-style: none; padding: 0; margin: 0 0 20px; }
        .feature-list li { position: relative; padding-left: 22px; margin-bottom: 10px; color: var(--text-sec); font-size: 14.5px; }
        .feature-list li::before { content: "•"; color: var(--teal); font-size: 18px; position: absolute; left: 0; top: -1px; font-weight: 900; }
        .feature-list li strong { color: var(--text); }

        /* ── HIGHLIGHT / ALERT / INSTRUCTION ── */
        .highlight-box { background: var(--teal-xlight); border: 1px solid var(--border); padding: 22px 26px; border-radius: 8px; margin-top: 22px; }
        .highlight-box p { margin: 0 0 10px; font-size: 14.5px; color: var(--text-sec); }
        .highlight-box p:last-child { margin-bottom: 0; }
        .highlight-box strong { color: var(--text); }

        .instruction-box { background: rgba(14,165,233,0.06); border: 1px solid rgba(14,165,233,0.2); border-radius: 8px; padding: 18px 22px; margin-bottom: 28px; display: flex; gap: 14px; align-items: flex-start; font-size: 14px; color: var(--text-sec); }
        .instruction-box i { font-size: 18px; color: var(--info); flex-shrink: 0; margin-top: 2px; }
        .instruction-box strong { color: var(--text); }

        .alert-banner { background: var(--teal-xlight); border: 1px solid rgba(0,181,173,0.3); border-radius: 8px; padding: 18px 22px; margin-bottom: 28px; display: flex; gap: 14px; align-items: flex-start; font-size: 14px; color: var(--text-sec); }
        .alert-banner i { font-size: 18px; color: var(--teal); flex-shrink: 0; margin-top: 2px; }
        .alert-banner strong { display: block; margin-bottom: 4px; color: var(--text); }

        /* ── QUOTES ── */
        .quote-block { font-family: var(--font-serif); font-size: 17px; color: var(--text); border-left: 4px solid var(--border); padding-left: 22px; margin: 28px 0; line-height: 1.6; }
        .quote-block.featured { border-left: 4px solid var(--teal); background: var(--teal-xlight); padding: 28px 32px; border-radius: 0 10px 10px 0; font-size: 19px; box-shadow: 0 4px 20px rgba(0,181,173,0.1); }
        .quote-block small { font-family: var(--font-sans); display: block; font-size: 11px; color: var(--teal-dark); margin-top: 14px; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 700; }

        /* ── METHOD A/B/CLIP ── */
        .method-ab-container { display: flex; flex-direction: column; gap: 22px; }
        .point-card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 28px; }
        .point-card.point-a { border-top: 4px solid var(--danger); }
        .point-card.point-b { border-top: 4px solid var(--success); }
        .point-card h4 { font-family: var(--font-serif); font-size: 22px; margin: 0 0 14px; display: flex; align-items: center; gap: 10px; }
        .point-a h4 { color: var(--danger); }
        .point-b h4 { color: var(--success); }

        .method-name-block { background: var(--teal-dark); color: #fff; padding: 26px; border-radius: 12px; text-align: center; margin: 8px 0; }
        .method-name-block .label { font-size: 10px; text-transform: uppercase; letter-spacing: 2px; color: var(--teal-mid); font-weight: 700; margin-bottom: 8px; }
        .method-name-block h3 { font-family: var(--font-serif); font-size: 28px; color: #fff; margin: 0; }
        .method-name-block .acronym { color: var(--teal-mid); }

        .method-bridge { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,180px),1fr)); gap: 14px; margin-top: 20px; }
        .step-card { background: var(--teal-dark); color: white; padding: 22px; border-radius: 10px; text-align: center; }
        .step-card.final { border: 2px solid var(--teal); }
        .step-letter { background: var(--teal); color: white; width: 42px; height: 42px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 20px; font-family: var(--font-serif); margin: 0 auto 12px; }
        .step-tag { display: inline-block; font-size: 9px; text-transform: uppercase; letter-spacing: 1px; color: var(--teal-mid); font-weight: 700; margin-bottom: 6px; }
        .step-card h5 { font-family: var(--font-serif); font-size: 17px; margin: 0 0 6px; color: #e0f7f6; }
        .step-card p { font-size: 12px; color: rgba(255,255,255,0.55); margin: 0; line-height: 1.5; }

        /* ── INSTAGRAM GRID ── */
        .ig-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,280px),1fr)); gap: 20px; margin-top: 28px; }
        .ig-element { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 22px; }
        .ig-element h4 { font-size: 13px; text-transform: uppercase; letter-spacing: 1px; color: var(--teal-dark); margin: 0 0 14px; display: flex; align-items: center; gap: 8px; font-weight: 700; }
        .ig-element h4 i { color: var(--teal); }

        /* ── STORY BLOCK ── */
        .raw-story-block { background: var(--teal-xlight); border-left: 4px solid var(--teal-dark); padding: 30px; font-family: var(--font-serif); font-size: 16px; line-height: 1.8; color: var(--text-sec); border-radius: 0 10px 10px 0; margin-top: 22px; }
        .story-section { margin-bottom: 26px; }
        .story-section h4 { font-family: var(--font-sans); font-size: 10px; text-transform: uppercase; letter-spacing: 2px; color: var(--teal); margin-bottom: 6px; font-weight: 700; }
        .story-section h3 { font-family: var(--font-serif); font-size: 20px; color: var(--teal-dark); margin-bottom: 10px; }

        /* ── PAIN LAYERS ── */
        .pain-layer { background: var(--surface); padding: 20px; border-radius: 8px; border-left: 3px solid var(--teal); border-top: 1px solid var(--border); border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); }
        .pain-layer h5 { font-size: 10px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); margin-bottom: 10px; }
        .pain-layer h4 { font-family: var(--font-serif); font-size: 17px; margin-bottom: 10px; color: var(--teal-dark); }
        .pain-layer p { font-size: 13.5px; color: var(--text-sec); margin-bottom: 6px; line-height: 1.5; }
        .pain-layer strong { color: var(--text); }

        /* ── VOCAB ── */
        .vocab-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,280px),1fr)); gap: 20px; margin-top: 20px; }
        .vocab-card { padding: 22px; border-radius: 10px; }
        .vocab-card.positive { background: rgba(0,181,173,0.06); border: 1px solid rgba(0,181,173,0.2); }
        .vocab-card.negative { background: rgba(211,47,47,0.05); border: 1px solid rgba(211,47,47,0.18); }
        .vocab-card h5 { font-family: var(--font-serif); font-size: 17px; margin-bottom: 14px; display: flex; align-items: center; gap: 8px; }
        .vocab-card.positive h5 { color: var(--teal-dark); }
        .vocab-card.negative h5 { color: var(--danger); }
        .vocab-list { display: flex; flex-wrap: wrap; gap: 8px; }
        .vocab-pill { padding: 5px 11px; border-radius: 20px; font-size: 12.5px; font-weight: 500; background: var(--surface); border: 1px solid var(--border); color: var(--text-sec); }

        /* ── VERBATIM ── */
        .verbatim-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,260px),1fr)); gap: 12px; margin-top: 20px; }
        .verbatim-item { background: var(--surface); border-left: 3px solid var(--teal); padding: 16px 18px; border-radius: 0 6px 6px 0; display: flex; gap: 12px; align-items: flex-start; border-top: 1px solid var(--border); border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); }
        .v-num { background: var(--teal-dark); color: var(--teal-mid); font-weight: 700; font-size: 12px; padding: 3px 7px; border-radius: 4px; flex-shrink: 0; }
        .v-content p { font-family: var(--font-serif); font-size: 14px; color: var(--text); font-style: italic; margin-bottom: 5px; }
        .v-content small { font-size: 11.5px; color: var(--text-muted); }

        /* ── CONTENT PILLARS ── */
        .content-pillar-card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 28px; margin-bottom: 20px; }
        .content-pillar-card.alcance { border-top: 4px solid var(--info); }
        .content-pillar-card.movimento { border-top: 4px solid var(--success); }
        .content-pillar-card.doutrinacao { border-top: 4px solid var(--teal); }
        .content-pillar-card h4 { font-family: var(--font-serif); font-size: 20px; margin-bottom: 10px; color: var(--text); }
        .content-pillar-card .pillar-sub { font-size: 13.5px; color: var(--text-sec); margin-bottom: 18px; }
        .ideas-box { background: var(--bg); padding: 16px; border: 1px dashed var(--border); border-radius: 6px; }
        .ideas-box strong { display: block; font-size: 10px; text-transform: uppercase; color: var(--text-muted); margin-bottom: 8px; letter-spacing: 1px; }
        .ideas-box ul { padding-left: 18px; font-size: 13.5px; color: var(--text-sec); }
        .ideas-box ul li { margin-bottom: 5px; }

        /* ── CALENDAR ── */
        .calendar-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,200px),1fr)); gap: 12px; margin-top: 20px; }
        .calendar-item { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 18px; }
        .calendar-day { font-family: var(--font-serif); font-size: 17px; color: var(--teal); margin-bottom: 3px; }
        .calendar-type { font-size: 10px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); font-weight: 700; margin-bottom: 10px; }
        .calendar-desc { font-size: 13px; color: var(--text-sec); line-height: 1.5; }

        /* ── SCRIPT BLOCK ── */
        .script-block { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 26px; margin-bottom: 20px; }
        .script-block .block-title { font-size: 10px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--teal); font-weight: 700; margin-bottom: 10px; }
        .script-block h4 { font-family: var(--font-serif); font-size: 19px; color: var(--text); margin-bottom: 12px; }
        .script-block p { color: var(--text-sec); font-size: 14.5px; line-height: 1.6; margin-bottom: 10px; }

        /* ── OBJECTIONS ── */
        .objection-grid { display: grid; gap: 14px; margin-top: 20px; }
        .objection-card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 20px; }
        .objection-question { font-family: var(--font-serif); font-size: 16px; color: var(--danger); margin-bottom: 8px; font-style: italic; }
        .objection-answer { font-size: 13.5px; color: var(--text-sec); line-height: 1.6; }
        .objection-answer strong { color: var(--text); }

        /* ── TIERS ── */
        .tier-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,240px),1fr)); gap: 18px; margin-top: 28px; }
        .tier-card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 28px; display: flex; flex-direction: column; position: relative; }
        .tier-card.featured-tier { border-color: var(--teal); box-shadow: 0 6px 24px rgba(0,181,173,0.15); }
        .tier-name { font-family: var(--font-serif); font-size: 20px; color: var(--text); margin-bottom: 6px; }
        .tier-desc { font-size: 13px; color: var(--text-sec); line-height: 1.5; margin-bottom: 14px; }
        .tier-price { font-size: 24px; font-weight: 700; color: var(--teal-dark); border-top: 1px solid var(--border-light); padding-top: 14px; margin-bottom: 18px; }
        .tier-price small { display: block; font-size: 11px; font-weight: 400; color: var(--text-muted); margin-top: 3px; }
        .tier-badge { position: absolute; top: -11px; left: 50%; transform: translateX(-50%); background: var(--teal); color: #fff; font-size: 9px; font-weight: 700; text-transform: uppercase; padding: 4px 12px; border-radius: 20px; letter-spacing: 1px; white-space: nowrap; }
        .tier-features { list-style: none; padding: 0; margin: 0; flex: 1; }
        .tier-features li { font-size: 13.5px; color: var(--text-sec); margin-bottom: 10px; padding-left: 22px; position: relative; }
        .tier-features li i { position: absolute; left: 0; top: 4px; color: var(--teal); font-size: 11px; }

        /* ── REF CARDS ── */
        .ref-digital-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,270px),1fr)); gap: 18px; margin-top: 20px; }
        .ref-card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 22px; }
        .ref-card-header { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; }
        .ref-card-icon { width: 42px; height: 42px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 19px; color: #fff; flex-shrink: 0; }
        .ref-card-icon.ig { background: linear-gradient(135deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888); }
        .ref-card-icon.gmb { background: #4285F4; }
        .ref-card-title { font-weight: 700; font-size: 15px; color: var(--text); }
        .ref-row { display: flex; justify-content: space-between; align-items: flex-start; padding: 9px 0; border-bottom: 1px solid var(--border-light); gap: 10px; }
        .ref-row:last-child { border-bottom: none; }
        .ref-label { font-size: 12.5px; color: var(--text-muted); }
        .ref-value { font-size: 13.5px; font-weight: 600; color: var(--text); text-align: right; }
        .ref-value.highlight { color: var(--teal-dark); font-size: 17px; }
        .ref-value.ok { color: var(--success); }
        .ref-value.warn { color: var(--warn); }
        .ref-value.danger { color: var(--danger); }

        /* ── GMB UNITS ── */
        .gmb-unit-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,180px),1fr)); gap: 10px; margin-top: 18px; }
        .gmb-unit { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 16px; }
        .gmb-unit.s-ok { border-left: 4px solid var(--success); }
        .gmb-unit.s-warn { border-left: 4px solid var(--warn); }
        .gmb-unit.s-danger { border-left: 4px solid var(--danger); }
        .gmb-unit .u-name { font-weight: 700; font-size: 13px; color: var(--text); margin-bottom: 5px; }
        .gmb-unit .u-stars { font-family: var(--font-serif); font-size: 20px; color: var(--teal); }
        .gmb-unit .u-count { font-size: 11px; color: var(--text-muted); margin-top: 3px; }

        /* ── JOURNEY FLOW ── */
        .journey-flow { display: flex; align-items: center; justify-content: center; gap: 20px; background: var(--teal-dark); padding: 36px; border-radius: 12px; margin-bottom: 36px; flex-wrap: wrap; }
        .jf-node { background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.15); padding: 22px 18px; border-radius: 10px; text-align: center; position: relative; min-width: 130px; display: flex; flex-direction: column; align-items: center; }
        .jf-node i.icon-main { font-size: 30px; color: var(--teal-mid); margin-bottom: 10px; }
        .jf-node span { font-family: var(--font-serif); font-size: 16px; color: #fff; font-weight: 600; }
        .jf-action-badge { position: absolute; bottom: -12px; background: var(--teal); color: #fff; font-size: 9px; font-weight: 700; padding: 5px 12px; border-radius: 20px; text-transform: uppercase; letter-spacing: 1px; white-space: nowrap; }
        .jf-arrow { color: rgba(255,255,255,0.3); font-size: 22px; }
